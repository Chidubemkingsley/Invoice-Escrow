# --- required ---
PRIVATE_KEY=0x...            # deployer; also pool owner + LP in the demo (needs gas token + LP_USDG of USDG)

# --- demo only (two more funded wallets) ---
SELLER_KEY=0x...             # needs gas token
BUYER_KEY=0x...              # needs gas token + INVOICE_USDG of USDG (from https://faucet.paxos.com/)
LP_USDG=500
INVOICE_USDG=100

# --- optional ---
OWNER=                       # admin address (multisig for mainnet). Default: deployer
ARBITER=                     # dispute arbiter to approve on the pool
FEE_BPS=0                    # protocol fee, max 100
FEE_RECIPIENT=
USDG_ADDRESS=                # override the token address
ETHERSCAN_API_KEY=           # for --verify on Arbitrum (Arbiscan)
